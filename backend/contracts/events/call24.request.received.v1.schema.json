{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moriton.example/contracts/call24.request.received.v1.schema.json",
  "title": "Call 24 request received",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "message_type", "producer", "destination", "organization_id", "branch_id", "aggregate_id", "aggregate_version", "operation_id", "correlation_id", "causation_id", "occurred_at", "actor_reference", "policy_version", "payload"],
  "properties": {
    "schema_version": {"const": 1}, "message_id": {"type": "string", "format": "uuid"},
    "message_type": {"const": "call24.request.received.v1"}, "producer": {"const": "integrations"},
    "destination": {"const": "clinical"}, "organization_id": {"type": "string", "format": "uuid"},
    "branch_id": {"type": "string", "format": "uuid"}, "aggregate_id": {"type": "string", "format": "uuid"},
    "aggregate_version": {"type": "integer", "minimum": 1}, "operation_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"}, "causation_id": {"type": ["string", "null"]},
    "occurred_at": {"type": "string", "format": "date-time"}, "actor_reference": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1}, "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {"payload": {"type": "object", "additionalProperties": false, "required": ["source_request_id", "status", "received_at", "category_labels", "customer_name", "phone", "summary", "source_revision"], "properties": {
    "source_request_id": {"type": "string"}, "source_call_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string"}, "received_at": {"type": ["string", "null"], "format": "date-time"},
    "category_labels": {"type": "array", "items": {"type": "string"}}, "customer_name": {"type": ["string", "null"]},
    "phone": {"type": ["string", "null"]}, "summary": {"type": ["string", "null"]},
    "source_revision": {"type": "string"}, "matching_status": {"const": "unconfirmed"}
  }}}
}
